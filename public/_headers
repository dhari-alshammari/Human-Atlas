# Cloudflare Pages reads this file from the root of the deployed site.

# The bundle carries a content hash in its name, so it can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The packed male model (2026-11-22) has a content hash in every file name, so it can be kept for a year.
/models/body-*-*-*.bin.gz
  Cache-Control: public, max-age=31536000, immutable

# Other geometry keeps the same names across rebuilds, so it must stay revalidatable:
# a day from cache, then served stale while the new copy is fetched behind it.
/models/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.svg
  Cache-Control: public, max-age=604800
